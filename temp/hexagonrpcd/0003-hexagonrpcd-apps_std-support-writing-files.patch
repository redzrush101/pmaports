 	{ HRPC_ARG_WORD, sizeof(uint32_t) },
 	{ HRPC_ARG_WORD, sizeof(uint32_t) },
@@ -182,3 +197,16 @@ const struct hrpc_method_def_interp4 apps_std_stat_def = {
 	.n_inner_types = 0,
 	.inner_types = NULL,
 };
+
+static struct hrpc_arg_def_interp4 apps_std_frename_args[] = {
