From bdd40cc66c43282b6971cb70a09e1ea4a6107a4b Mon Sep 17 00:00:00 2001
From: Yassin Rezai <yassinrsocial@proton.me>
Date: Tue, 6 Oct 2026 21:20:56 +0200
Subject: [PATCH 3/7] hexagonrpcd: apps_std: support writing files

Remote processors open files for writing and expect them to be created
or truncated, then write them and rename them over their destination.

Translate the stdio modes of fopen_with_env to open flags, use the
writing lookup for writing modes and implement fwrite and frename.
Writes to read-only locations are still refused with the existing
message.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Yassin Rezai <yassinrsocial@proton.me>
---
 hexagonrpcd/apps_std.c           | 140 +++++++++++++++++++++++++++----
 hexagonrpcd/interface/apps_std.c |  28 +++++++
 hexagonrpcd/interface/apps_std.h |   2 +
 3 files changed, 152 insertions(+), 18 deletions(-)

diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index 7172bf0..b6a5fd9 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -20,7 +20,9 @@
  */
 
 #include <errno.h>
+#include <fcntl.h>
 #include <libhexagonrpc/error.h>
+#include <stdbool.h>
 #include <stdio.h>
 #include <stdint.h>
 #include <string.h>
@@ -120,6 +122,38 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	ssize_t ret;
+
+	ret = hexagonfs_write(ctx->fds, first_in->fd,
+			      inbufs[1].s, inbufs[1].p);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write file: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("write(%u, %zu) -> %zd\n", first_in->fd, inbufs[1].s, ret);
+#endif
+
+	first_out->written = ret;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -150,14 +184,33 @@ static uint32_t apps_std_fseek(void *data,
 	return 0;
 }
 
+/*
+ * Translate a C stdio mode string to open() flags for writing. Read-only
+ * modes return 0, so they keep using the read-only lookup.
+ */
+static int mode_to_write_flags(const char *mode)
+{
+	bool update = strchr(mode, '+') != NULL;
+
+	switch (mode[0]) {
+	case 'r':
+		return update ? O_RDWR : 0;
+	case 'w':
+		return (update ? O_RDWR : O_WRONLY) | O_CREAT | O_TRUNC;
+	case 'a':
+		return (update ? O_RDWR : O_WRONLY) | O_CREAT | O_APPEND;
+	default:
+		return -EINVAL;
+	}
+}
+
 static uint32_t apps_std_fopen_with_env(void *data,
 					const struct fastrpc_io_buffer *inbufs,
 					struct fastrpc_io_buffer *outbufs)
 {
 	struct apps_std_ctx *ctx = data;
 	uint32_t *out = outbufs[0].p;
-	char rw_mode;
-	int dirfd, fd;
+	int dirfd, fd, write_flags;
 
 	// The name and environment variable must also be NULL-terminated
 	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
@@ -165,12 +218,9 @@ static uint32_t apps_std_fopen_with_env(void *data,
 	 || ((const char *) inbufs[4].p)[inbufs[4].s - 1] != 0)
 		return AEE_EBADPARM;
 
-	rw_mode = ((const char *) inbufs[4].p)[0];
-	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
-	}
+	write_flags = mode_to_write_flags(inbufs[4].p);
+	if (write_flags < 0)
+		return AEE_EBADPARM;
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
 		dirfd = ctx->adsp_library_dirfd;
@@ -188,18 +238,33 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EFAILED;
 	}
 
-	fd = hexagonfs_openat(ctx->fds, ctx->rootfd, dirfd, inbufs[3].p);
-	if (fd < 0) {
-		fprintf(stderr, "Could not open %s: %s\n",
-				(const char *) inbufs[3].p,
-				strerror(errno));
-		return AEE_EFAILED;
+	if (write_flags) {
+		fd = hexagonfs_openat_write(ctx->fds, ctx->rootfd, dirfd,
+					    inbufs[3].p, write_flags);
+		if (fd == -EROFS) {
+			fprintf(stderr, "Tried to open %s for writing\n",
+					(const char *) inbufs[3].p);
+			return AEE_EUNSUPPORTED;
+		} else if (fd < 0) {
+			fprintf(stderr, "Could not open %s for writing: %s\n",
+					(const char *) inbufs[3].p,
+					strerror(-fd));
+			return AEE_EFAILED;
+		}
+	} else {
+		fd = hexagonfs_openat(ctx->fds, ctx->rootfd, dirfd, inbufs[3].p);
+		if (fd < 0) {
+			fprintf(stderr, "Could not open %s: %s\n",
+					(const char *) inbufs[3].p,
+					strerror(errno));
+			return AEE_EFAILED;
+		}
 	}
 
 #ifdef HEXAGONRPC_VERBOSE
-	printf("openat($%s, %s, %c) -> %d\n", (const char *) inbufs[1].p,
+	printf("openat($%s, %s, %s) -> %d\n", (const char *) inbufs[1].p,
 					      (const char *) inbufs[3].p,
-					      rw_mode,
+					      (const char *) inbufs[4].p,
 					      fd);
 #endif
 
@@ -405,6 +470,37 @@ void fastrpc_apps_std_deinit(struct fastrpc_interface *iface)
 	free(iface);
 }
 
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *oldname = inbufs[1].p;
+	const char *newname = inbufs[2].p;
+	int ret;
+
+	if (!inbufs[1].s || oldname[inbufs[1].s - 1] != 0
+	 || !inbufs[2].s || newname[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_rename(ctx->fds, ctx->rootfd, ctx->rootfd,
+			       oldname, newname);
+	if (ret == -EROFS) {
+		fprintf(stderr, "Tried to rename %s to %s\n", oldname, newname);
+		return AEE_EUNSUPPORTED;
+	} else if (ret) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+				oldname, newname, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("rename(%s, %s)\n", oldname, newname);
+#endif
+
+	return 0;
+}
+
 static const struct fastrpc_function_impl apps_std_procs[] = {
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
@@ -420,7 +516,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_fread_def,
 		.impl = apps_std_fread,
 	},
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fwrite_def,
+		.impl = apps_std_fwrite,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
@@ -465,10 +564,15 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_stat_def,
 		.impl = apps_std_stat,
 	},
+	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_frename_def,
+		.impl = apps_std_frename,
+	},
 };
 
 const struct fastrpc_interface apps_std_interface = {
 	.name = "apps_std",
-	.n_procs = 32,
+	.n_procs = 34,
 	.procs = apps_std_procs,
 };
