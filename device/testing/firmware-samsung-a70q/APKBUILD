maintainer="Yassin Rezai <yassinrsocial@proton.me>"
pkgname=firmware-samsung-a70q
pkgver=1
pkgrel=0
_commit="9b96ba6e9540b00fc6f1f3cc09f607db68ef3f3b"
_linux_firmware_ver=20260110
pkgdesc="Firmware for the Samsung Galaxy A70"
url="https://github.com/redzrush101/firmware-samsung-a70q"
arch="aarch64"
license="proprietary"
subpackages="
	$pkgname-adreno
	$pkgname-adsp
	$pkgname-modem
	$pkgname-venus
	$pkgname-wlan
	"
makedepends="qca-swiss-army-knife"
options="!archcheck !check !strip !tracedeps pmb:cross-native"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	linux-firmware-$_linux_firmware_ver.tar.gz::https://gitlab.com/kernel-firmware/linux-firmware/-/archive/$_linux_firmware_ver/linux-firmware-$_linux_firmware_ver.tar.gz
	30-initramfs-firmware.files
"
builddir="$srcdir/firmware-samsung-a70q-$_commit"

build() {
	# The WLAN firmware reports board ID 0xff and chip ID 0x140; the DT
	# selects this entry with qcom,calibration-variant.
	cat > board-2.json <<-EOF
	[{
		"names": ["bus=snoc,qmi-board-id=ff,qmi-chip-id=140,variant=Samsung_Galaxy_A70"],
		"data": "bdwlan.bin"
	}]
	EOF
	ath10k-bdencoder -c board-2.json -o board-2.bin
}

package() {
	# Parent package is empty; the device package selects the required firmware.
	mkdir -p "$pkgdir"
}

adsp() {
	pkgdesc="ADSP firmware for the Samsung Galaxy A70"

	local _firmware="$subpkgdir/usr/lib/firmware/qcom/sm6150/a70q"

	install -Dm644 \
		"$builddir"/adsp.mdt \
		"$builddir"/adsp.b* \
		"$builddir"/adspr.jsn \
		"$builddir"/adsps.jsn \
		"$builddir"/adspua.jsn \
		-t "$_firmware"
}

adreno() {
	pkgdesc="Adreno firmware for the Samsung Galaxy A70"

	local _firmware="$subpkgdir/usr/lib/firmware/qcom"
	local _linux_firmware="$srcdir/linux-firmware-$_linux_firmware_ver"

	install -Dm644 "$_linux_firmware/LICENSE.qcom" \
		"$subpkgdir/usr/share/licenses/$subpkgname/LICENSE.qcom"
	install -Dm644 "$_linux_firmware/qcom/NOTICE.txt" \
		"$subpkgdir/usr/share/licenses/$subpkgname/NOTICE.txt"
	install -Dm644 "$_linux_firmware/qcom/a612_rgmu.bin" -t "$_firmware"
	install -Dm644 "$_linux_firmware/qcom/a630_sqe.fw" -t "$_firmware"

	install -Dm644 \
		"$builddir"/a612_zap.mdt \
		"$builddir"/a612_zap.b* \
		-t "$_firmware/sm6150/a70q"

	install -Dm644 "$srcdir"/30-initramfs-firmware.files \
		-t "$subpkgdir"/usr/share/mkinitfs/files
}

modem() {
	pkgdesc="Modem firmware for the Samsung Galaxy A70"

	install -Dm644 \
		"$builddir"/modem.mdt \
		"$builddir"/modem.b* \
		"$builddir"/modemr.jsn \
		-t "$subpkgdir/usr/lib/firmware/qcom/sm6150/a70q"
}

venus() {
	pkgdesc="Venus video firmware for the Samsung Galaxy A70"

	local _firmware="$subpkgdir/usr/lib/firmware/qcom/sm6150/a70q"

	install -Dm644 "$builddir"/venus.mdt "$builddir"/venus.b* \
		-t "$_firmware"
}

wlan() {
	pkgdesc="Wi-Fi firmware for the Samsung Galaxy A70"
	depends="$pkgname-modem linux-firmware-ath10k"

	# The modem loads wlanmdsp.mbn over TFTP from the directory of its own
	# firmware; ath10k reads board data from the DT firmware-name directory.
	install -Dm644 "$builddir"/wlanmdsp.mbn \
		-t "$subpkgdir/usr/lib/firmware/qcom/sm6150/a70q"
	install -Dm644 "$builddir"/board-2.bin \
		-t "$subpkgdir/usr/lib/firmware/ath10k/WCN3990/hw1.0/sm6150"
}

