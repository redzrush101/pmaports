From 427396e81049167c44e95e7bf37c05bb1d9bef59 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Tue, 8 Sep 2026 17:36:47 +0200
Subject: [PATCH 20/37] drm/msm/dpu: increase frame-event burst headroom

Console updates during early boot can queue more than four completion
events before the worker drains them. Use eight bounded event slots,
matching downstream DPU headroom, to avoid dropping completion accounting.

Signed-off-by: Yassin <yassin@Nixos>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
index 6eaba5696..c121ad4b4 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
@@ -16,8 +16,8 @@
 
 #define DPU_CRTC_NAME_SIZE	12
 
-/* define the maximum number of in-flight frame events */
-#define DPU_CRTC_FRAME_EVENT_SIZE	4
+/* Allow headroom for bursts of in-flight frame events. */
+#define DPU_CRTC_FRAME_EVENT_SIZE	8
 
 /**
  * enum dpu_crtc_client_type: crtc client type
