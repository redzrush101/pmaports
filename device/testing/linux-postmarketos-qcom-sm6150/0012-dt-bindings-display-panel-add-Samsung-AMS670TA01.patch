From 8fbe3864d03a7c6fde405bfbce9108de6435cce3 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Tue, 8 Sep 2026 00:03:25 +0200
Subject: [PATCH 12/29] dt-bindings: display: panel: add Samsung AMS670TA01

Document the AMS670TA01 panel found in the Samsung Galaxy A70.
Unlike AMS646YB01, this panel is powered by VDDIO and VCI supplies.

Signed-off-by: Yassin <yassin@Nixos>
---
 .../display/panel/samsung,s6e3fc2x01.yaml     | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,s6e3fc2x01.yaml b/Documentation/devicetree/bindings/display/panel/samsung,s6e3fc2x01.yaml
index fd4388f5f..30ad4520c 100644
--- a/Documentation/devicetree/bindings/display/panel/samsung,s6e3fc2x01.yaml
+++ b/Documentation/devicetree/bindings/display/panel/samsung,s6e3fc2x01.yaml
@@ -14,17 +14,41 @@ description: The S6E3FC2X01 is display driver IC with connected panel.
 allOf:
   - $ref: panel-common.yaml#
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,s6e3fc2x01-ams641rw
+    then:
+      required:
+        - poc-supply
+        - vci-supply
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,s6e3fc2x01-ams670ta01
+    then:
+      required:
+        - enable-gpios
+        - vci-supply
+
 properties:
   compatible:
     items:
       - enum:
             # Samsung 6.41 inch, 1080x2340 pixels, 19.5:9 ratio
           - samsung,s6e3fc2x01-ams641rw
+            # Samsung 6.7 inch, 1080x2400 pixels, 20:9 ratio
+          - samsung,s6e3fc2x01-ams670ta01
       - const: samsung,s6e3fc2x01
 
   reg:
     maxItems: 1
 
+  enable-gpios: true
+
   poc-supply:
     description: POC regulator
 
@@ -37,8 +61,6 @@ properties:
 required:
   - compatible
   - reset-gpios
-  - poc-supply
-  - vci-supply
   - vddio-supply
 
 unevaluatedProperties: false
