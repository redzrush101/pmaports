From d927c2dac1c16544c2492f08c7985e2bc634af23 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Thu, 10 Sep 2026 23:08:30 +0200
Subject: [PATCH 36/37] arm64: dts: qcom: sm6150-samsung-a70q: enable Venus

The QCS615 Venus node already describes the clocks, power domains,
interconnect paths, IOMMU and reserved memory required by the hardware.

Enable it on the Galaxy A70 and select the board firmware extracted
from the matching Samsung release.

Signed-off-by: Yassin <yassin@Nixos>
---
 arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
index 7a53334d6..01eb7bdde 100644
--- a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
+++ b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
@@ -550,3 +550,8 @@ &usb_1_hsphy {
 	vdda-pll-supply = <&vreg_l11a_1p8>;
 	status = "okay";
 };
+
+&venus {
+	firmware-name = "qcom/sm6150/a70q/venus.mdt";
+	status = "okay";
+};
