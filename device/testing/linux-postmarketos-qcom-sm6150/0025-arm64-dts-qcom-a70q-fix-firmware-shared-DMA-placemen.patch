From da81549e1663b368f78f40d781796d62638546f7 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Wed, 9 Sep 2026 22:17:23 +0200
Subject: [PATCH 25/37] arm64: dts: qcom: a70q: fix firmware-shared DMA
 placement

Samsung firmware assigns the ADSP remote heap at 0xef000000 and the
default CMA area at 0xf4400000. Leaving both allocations dynamic lets
the upstream reserved-memory allocator place them at the top of the
32-bit address space instead.

That puts generic coherent allocations inside the range assigned to
secure display by QHEE. In particular, PAS_INIT_IMAGE rejects ADSP
metadata from that range with secure-world error -0x300045.

Describe the addresses observed in the downstream live DT and boot log.
This keeps PAS metadata in the HLOS CMA area and the ADSP heap at its
firmware-assigned address.

Signed-off-by: Yassin <yassin@Nixos>
---
 arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
index 0c78264aa..e96bc7485 100644
--- a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
+++ b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
@@ -191,9 +191,25 @@ modem_shared_mem: modem-shared@ba000000 {
 			reg = <0x0 0xba000000 0x0 0x6000000>;
 			no-map;
 		};
+
+		linux_cma: linux,cma@f4400000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0xf4400000 0x0 0x2800000>;
+			reusable;
+			linux,cma-default;
+		};
 	};
 };
 
+/* Keep firmware-shared allocations at the addresses assigned by Samsung's QHEE. */
+&adsp_rpc_remote_heap_mem {
+	/delete-property/ alignment;
+	/delete-property/ alloc-ranges;
+	/delete-property/ size;
+
+	reg = <0x0 0xef000000 0x0 0x800000>;
+};
+
 /* Match the OPPs programmed by the A70 firmware's cpufreq hardware LUT. */
 &cpu0_opp_table {
 	/delete-node/ opp-998400000;
