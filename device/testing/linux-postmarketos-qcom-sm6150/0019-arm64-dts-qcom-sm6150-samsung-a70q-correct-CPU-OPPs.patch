From 95bb5d8f63a75e086919f185feddf879ddc51640 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Tue, 8 Sep 2026 23:14:17 +0200
Subject: [PATCH 19/29] arm64: dts: qcom: sm6150-samsung-a70q: correct CPU OPPs

The cpufreq-hw LUT programmed by the A70 firmware differs from the
shared Talos tables. Correct the board-specific tables so the driver can
attach the LUT voltages and expose every supported frequency.

Signed-off-by: Yassin <yassin@Nixos>
---
 .../boot/dts/qcom/sm6150-samsung-a70q.dts     | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
index d6c1a0d4a..f1451c599 100644
--- a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
+++ b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
@@ -206,6 +206,30 @@ &adsp_rpc_remote_heap_mem {
 	reg = <0x0 0xef000000 0x0 0x800000>;
 };
 
+/* Match the OPPs programmed by the A70 firmware's cpufreq hardware LUT. */
+&cpu0_opp_table {
+	/delete-node/ opp-998400000;
+
+	opp-1017600000 {
+		opp-hz = /bits/ 64 <1017600000>;
+		opp-peak-kBps = <(451000 * 4) (806400 * 16)>;
+	};
+
+	opp-1708800000 {
+		opp-hz = /bits/ 64 <1708800000>;
+		opp-peak-kBps = <(1017000 * 4) (1363200 * 16)>;
+	};
+};
+
+&cpu6_opp_table {
+	/delete-node/ opp-1094400000;
+
+	opp-2016000000 {
+		opp-hz = /bits/ 64 <2016000000>;
+		opp-peak-kBps = <(1555000 * 4) (1363200 * 16)>;
+	};
+};
+
 /*
  * The Samsung firmware requires platform-specific preparation before CPU
  * power collapse.  Keep the architectural WFI idle state until that support
