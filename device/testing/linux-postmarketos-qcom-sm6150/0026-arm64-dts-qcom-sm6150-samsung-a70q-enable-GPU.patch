From 3690b0aff365c12405088e12bad6a4ac1ddea738 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Sat, 12 Sep 2026 13:42:50 +0200
Subject: [PATCH 26/28] arm64: dts: qcom: sm6150-samsung-a70q: enable GPU

Enable the Adreno 612 and select the Samsung-signed board zap firmware.
Replace the generic GPU OPP table with the five frequencies, RPMh levels
and bandwidth votes exposed for this board speed bin by downstream
firmware.

Signed-off-by: Yassin <yassin@Nixos>
---
 .../boot/dts/qcom/sm6150-samsung-a70q.dts     | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
index 7a0284527..3ed68b32b 100644
--- a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
+++ b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
@@ -230,6 +230,45 @@ opp-2016000000 {
 	};
 };
 
+/* Match the speed bin and bus levels selected by the Samsung firmware. */
+&gpu_opp_table {
+	/delete-node/ opp-845000000;
+	/delete-node/ opp-745000000;
+	/delete-node/ opp-650000000;
+	/delete-node/ opp-500000000;
+	/delete-node/ opp-435000000;
+
+	opp-290000000 {
+		opp-hz = /bits/ 64 <290000000>;
+		required-opps = <&rpmhpd_opp_low_svs>;
+		opp-peak-kBps = <1804000>;
+	};
+
+	opp-435000000 {
+		opp-hz = /bits/ 64 <435000000>;
+		required-opps = <&rpmhpd_opp_svs>;
+		opp-peak-kBps = <3000000>;
+	};
+
+	opp-550000000 {
+		opp-hz = /bits/ 64 <550000000>;
+		required-opps = <&rpmhpd_opp_svs_l1>;
+		opp-peak-kBps = <3975000>;
+	};
+
+	opp-700000000 {
+		opp-hz = /bits/ 64 <700000000>;
+		required-opps = <&rpmhpd_opp_nom>;
+		opp-peak-kBps = <5287500>;
+	};
+
+	opp-745000000 {
+		opp-hz = /bits/ 64 <745000000>;
+		required-opps = <&rpmhpd_opp_nom_l1>;
+		opp-peak-kBps = <7050000>;
+	};
+};
+
 /*
  * The Samsung firmware requires platform-specific preparation before CPU
  * power collapse.  Keep the architectural WFI idle state until that support
@@ -345,6 +384,14 @@ &gpi_dma0 {
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm6150/a70q/a612_zap.mdt";
+};
+
 &i2c1 {
 	clock-frequency = <400000>;
 	status = "okay";
