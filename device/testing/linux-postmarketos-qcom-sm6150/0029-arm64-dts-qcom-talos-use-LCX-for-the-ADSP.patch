From 37816e14fe4e790fe60fd16db112bd48d69b7164 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Wed, 9 Sep 2026 23:04:18 +0200
Subject: [PATCH 29/37] arm64: dts: qcom: talos: use LCX for the ADSP

The QCS615 ADSP logical VDD_CX supply is backed by lcx.lvl.

Vote LCX while starting the remote processor, matching downstream.

Signed-off-by: Yassin <yassin@Nixos>
---
 arch/arm64/boot/dts/qcom/talos.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/talos.dtsi b/arch/arm64/boot/dts/qcom/talos.dtsi
index eedfdce3c..e6f6f85bf 100644
--- a/arch/arm64/boot/dts/qcom/talos.dtsi
+++ b/arch/arm64/boot/dts/qcom/talos.dtsi
@@ -5246,8 +5246,8 @@ remoteproc_adsp: remoteproc@62400000 {
 			clocks = <&rpmhcc RPMH_CXO_CLK>;
 			clock-names = "xo";
 
-			power-domains = <&rpmhpd RPMHPD_CX>;
-			power-domain-names = "cx";
+			power-domains = <&rpmhpd RPMHPD_LCX>;
+			power-domain-names = "lcx";
 
 			memory-region = <&rproc_adsp_mem>;
 
