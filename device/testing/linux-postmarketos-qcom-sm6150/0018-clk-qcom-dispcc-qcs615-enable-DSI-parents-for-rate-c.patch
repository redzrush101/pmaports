From 9812e80b661bfc3ee206e413c374f3eb86a17255 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Tue, 8 Sep 2026 17:32:54 +0200
Subject: [PATCH 18/30] clk: qcom: dispcc-qcs615: enable DSI parents for rate
 changes

Keep the DSI PHY PLL parents enabled while updating the byte and pixel
RCG rates. The QCS615 display RCGs otherwise fail to latch their
configuration during the first modeset.

Signed-off-by: Yassin <yassin@Nixos>

diff --git a/drivers/clk/qcom/dispcc-qcs615.c b/drivers/clk/qcom/dispcc-qcs615.c
index 6a19f00f6..69eb82046 100644
--- a/drivers/clk/qcom/dispcc-qcs615.c
+++ b/drivers/clk/qcom/dispcc-qcs615.c
@@ -170,7 +170,8 @@ static struct clk_rcg2 disp_cc_mdss_byte0_clk_src = {
 		.name = "disp_cc_mdss_byte0_clk_src",
 		.parent_data = disp_cc_parent_data_2,
 		.num_parents = ARRAY_SIZE(disp_cc_parent_data_2),
-		.flags = CLK_SET_RATE_PARENT,
+		/* Parent DSI PHY PLL must be enabled for RCG updates to latch. */
+		.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
 		.ops = &clk_byte2_ops,
 	},
 };
@@ -295,7 +296,8 @@ static struct clk_rcg2 disp_cc_mdss_pclk0_clk_src = {
 		.name = "disp_cc_mdss_pclk0_clk_src",
 		.parent_data = disp_cc_parent_data_5,
 		.num_parents = ARRAY_SIZE(disp_cc_parent_data_5),
-		.flags = CLK_SET_RATE_PARENT,
+		/* Parent DSI PHY PLL must be enabled for RCG updates to latch. */
+		.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
 		.ops = &clk_pixel_ops,
 	},
 };
