From f08ecf2f7a515b66912a5c58e1e1feaf78d02b75 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Mon, 14 Sep 2026 11:33:07 +0200
Subject: [PATCH 30/31] arm64: dts: qcom: a70q: correct cluster idle states

Samsung downstream encodes the CX retention and LLCC-off modes as 0x124 and 0xb24. Combined with rail power collapse, these produce PSCI states 0x41001244 and 0x4100b244.

Override the inherited Talos values and restore the downstream latency ordering. Keep the states disabled until they pass staged runtime validation.

Signed-off-by: Yassin <yassin@Nixos>
---
 arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
index d557a4ff1..dd622fe2f 100644
--- a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
+++ b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
@@ -275,9 +275,8 @@ &venus_opp_table {
 };
 
 /*
- * The Samsung firmware requires platform-specific preparation before CPU
- * power collapse.  Keep the architectural WFI idle state until that support
- * is available in the mainline PSCI cpuidle path.
+ * Match the cluster modes and latency ordering used by the A70 firmware.
+ * Keep every non-WFI state disabled until it passes staged validation.
  */
 &little_cpu_sleep_0 {
 	status = "disabled";
@@ -300,10 +299,16 @@ &cluster_sleep_0 {
 };
 
 &cluster_sleep_1 {
+	arm,psci-suspend-param = <0x41001244>;
+	entry-latency-us = <3638>;
+
 	status = "disabled";
 };
 
 &cluster_sleep_2 {
+	arm,psci-suspend-param = <0x4100b244>;
+	entry-latency-us = <3263>;
+
 	status = "disabled";
 };
 
