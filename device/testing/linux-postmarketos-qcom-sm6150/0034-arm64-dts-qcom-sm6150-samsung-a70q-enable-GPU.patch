From a7d42d6cb20c1efb092c18dd4ef2382b125c4e45 Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Thu, 10 Sep 2026 18:35:43 +0200
Subject: [PATCH 34/37] arm64: dts: qcom: sm6150-samsung-a70q: enable GPU

The Galaxy A70 uses the Adreno 612 already described by Talos. Enable
it and point the zap shader loader at the signed device firmware extracted
from the Samsung image.

Signed-off-by: Yassin <yassin@Nixos>
---
 arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
index 6495e88a5..ebdba14c4 100644
--- a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
+++ b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
@@ -388,6 +388,14 @@ &gpi_dma0 {
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm6150/a70q/a612_zap.mdt";
+};
+
 &i2c1 {
 	clock-frequency = <400000>;
 	status = "okay";
