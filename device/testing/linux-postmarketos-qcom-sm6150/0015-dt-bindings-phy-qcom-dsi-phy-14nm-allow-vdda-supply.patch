From ae7b13c679361d889b384640977a373a7999b5ea Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Tue, 8 Sep 2026 09:34:41 +0200
Subject: [PATCH 15/37] dt-bindings: phy: qcom,dsi-phy-14nm: allow vdda supply

The QCS615 integration powers the 14 nm DSI PHY from an external
VDDA regulator. Document the optional supply used by that integration.

Signed-off-by: Yassin <yassin@Nixos>
---
 Documentation/devicetree/bindings/phy/qcom,dsi-phy-14nm.yaml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Documentation/devicetree/bindings/phy/qcom,dsi-phy-14nm.yaml b/Documentation/devicetree/bindings/phy/qcom,dsi-phy-14nm.yaml
index be31b9bac..6bc5d2f56 100644
--- a/Documentation/devicetree/bindings/phy/qcom,dsi-phy-14nm.yaml
+++ b/Documentation/devicetree/bindings/phy/qcom,dsi-phy-14nm.yaml
@@ -37,6 +37,9 @@ properties:
   vcca-supply:
     description: Phandle to vcca regulator device node.
 
+  vdda-supply:
+    description: Phandle to vdda regulator device node.
+
   power-domains:
     description:
       A phandle and PM domain specifier for an optional power domain.
