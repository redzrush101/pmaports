From d9f5dd1dd7662e00934fd6e0a2bc342297a07abb Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Sat, 12 Sep 2026 13:42:50 +0200
Subject: [PATCH 29/30] arm64: dts: qcom: sm6150-samsung-a70q: enable Venus

Enable Venus with the matching Samsung board firmware. Remove the
inherited 460 MHz OPP because the A70 firmware exposes video clock levels
only up to 410 MHz.

Signed-off-by: Yassin <yassin@Nixos>

diff --git a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
index 3ed68b32b..1671bf654 100644
--- a/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
+++ b/arch/arm64/boot/dts/qcom/sm6150-samsung-a70q.dts
@@ -269,6 +269,11 @@ opp-745000000 {
 	};
 };
 
+/* The A70 firmware does not expose the 460 MHz video clock level. */
+&venus_opp_table {
+	/delete-node/ opp-460000000;
+};
+
 /*
  * The Samsung firmware requires platform-specific preparation before CPU
  * power collapse.  Keep the architectural WFI idle state until that support
@@ -541,3 +546,8 @@ &usb_1_hsphy {
 	vdda-pll-supply = <&vreg_l11a_1p8>;
 	status = "okay";
 };
+
+&venus {
+	firmware-name = "qcom/sm6150/a70q/venus.mdt";
+	status = "okay";
+};
