From 0daf70d72729a377c05c44c119f8adf22be7219e Mon Sep 17 00:00:00 2001
From: Yassin <yassin@Nixos>
Date: Wed, 9 Sep 2026 23:04:18 +0200
Subject: [PATCH 28/37] remoteproc: qcom: pas: add QCS615 ADSP resources

The QCS615 compatible falls through to the SM8150 match data.

As a result the PAS driver votes CX while loading the ADSP.

Add QCS615 data selecting LCX.

The remaining PAS identifiers and subsystem metadata match SM8150.

Signed-off-by: Yassin <yassin@Nixos>
---
 drivers/remoteproc/qcom_q6v5_pas.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index ca8e61254..450e4e49d 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -1046,6 +1046,21 @@ static const struct qcom_pas_data sm6375_mpss_resource = {
 	.ssctl_id = 0x12,
 };
 
+static const struct qcom_pas_data qcs615_adsp_resource = {
+	.crash_reason_smem = 423,
+	.firmware_name = "adsp.mdt",
+	.pas_id = 1,
+	.auto_boot = true,
+	.proxy_pd_names = (char *[]){
+		"lcx",
+		NULL
+	},
+	.load_state = "adsp",
+	.ssr_name = "lpass",
+	.sysmon_name = "adsp",
+	.ssctl_id = 0x14,
+};
+
 static const struct qcom_pas_data sm8150_adsp_resource = {
 	.crash_reason_smem = 423,
 	.firmware_name = "adsp.mdt",
@@ -1845,6 +1860,7 @@ static const struct of_device_id qcom_pas_of_match[] = {
 	{ .compatible = "qcom,qcs404-adsp-pas", .data = &adsp_resource_init },
 	{ .compatible = "qcom,qcs404-cdsp-pas", .data = &cdsp_resource_init },
 	{ .compatible = "qcom,qcs404-wcss-pas", .data = &wcss_resource_init },
+	{ .compatible = "qcom,qcs615-adsp-pas", .data = &qcs615_adsp_resource },
 	{ .compatible = "qcom,sa8775p-adsp-pas", .data = &sa8775p_adsp_resource },
 	{ .compatible = "qcom,sa8775p-cdsp0-pas", .data = &sa8775p_cdsp0_resource },
 	{ .compatible = "qcom,sa8775p-cdsp1-pas", .data = &sa8775p_cdsp1_resource },
