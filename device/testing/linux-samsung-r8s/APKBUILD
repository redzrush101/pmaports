maintainer="Yassin <yassin@users.noreply.github.com>"
pkgname=linux-samsung-r8s
pkgver=7.2_git20260828
pkgrel=0
_commit="c20313e98b04ce543936431b6122dd639d3a8346"
pkgdesc="Mainline kernel for Samsung Galaxy S20 FE 4G"
arch="aarch64"
_carch="arm64"
_flavor="samsung-r8s"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	elfutils-dev
	findutils
	flex
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

source="
	$pkgname-$_commit.tar.gz::https://github.com/torvalds/linux/archive/$_commit.tar.gz
	0001-dt-bindings-ufs-samsung-Add-Exynos990-support.patch
	0002-phy-samsung-ufs-Add-Exynos990-support.patch
	0003-ufs-host-exynos-Add-Exynos990-support.patch
	0004-arm64-dts-exynos-Add-UFS-to-Exynos990.patch
	0005-arm64-dts-exynos-Enable-UFS-on-r8s.patch
	0006-arm64-dts-exynos-Add-ramoops-to-r8s.patch
	config-samsung-r8s.aarch64
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare

	make ARCH="$_carch" LLVM=1 defconfig
	scripts/kconfig/merge_config.sh -m .config \
		"$srcdir/config-samsung-r8s.$CARCH"
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		Image.gz modules exynos/exynos990-r8s.dtb
}

package() {
	make modules_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"
	install -Dm644 \
		"$builddir/arch/$_carch/boot/dts/exynos/exynos990-r8s.dtb" \
		"$pkgdir/boot/dtbs/exynos/exynos990-r8s.dtb"
	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	rm -f "$pkgdir"/usr/lib/modules/*/build \
		"$pkgdir"/usr/lib/modules/*/source
}

