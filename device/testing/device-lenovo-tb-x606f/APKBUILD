maintainer=""
pkgname=device-lenovo-tb-x606f
pkgdesc="Lenovo Tab M10 FHD Plus"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-lenovo-tb-x606f
	mkbootimg
	postmarketos-base
"
makedepends="
	android-tools-mkdtboimg
	devicepkg-dev
	dtc
"
source="
	deviceinfo
	kernel-cmdline.conf
	mt8768-lenovo-tb-x606f-lk.dtso
"

build() {
	devicepkg_build "$startdir" "$pkgname"

	# interrupt-parent is inherited from the base DT after LK applies the overlay.
	dtc -@ -Wno-chosen_node_is_root -Wno-interrupts_property \
		-I dts -O dtb \
		-o "$srcdir/mt8768-lenovo-tb-x606f-lk.dtbo" \
		"$srcdir/mt8768-lenovo-tb-x606f-lk.dtso"
	mkdtboimg create "$srcdir/dtbo.img" \
		"$srcdir/mt8768-lenovo-tb-x606f-lk.dtbo"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
}

