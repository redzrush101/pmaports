maintainer=""
pkgname=linux-lenovo-tb-x606f
pkgver=7.2_rc3
pkgrel=0
pkgdesc="Mainline kernel for Lenovo Tab M10 FHD Plus"
arch="aarch64"
_carch="arm64"
_flavor="lenovo-tb-x606f"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bison
	elfutils-dev
	findutils
	flex
	linux-headers
	openssl-dev
	pahole
	perl
	python3
	zstd
"

_config="config-$_flavor.$arch"
_outdir=".output"
source="
	$pkgname-$pkgver.tar.gz::https://git.kernel.org/torvalds/t/linux-${pkgver/_/-}.tar.gz
	0001-dt-bindings-mediatek-describe-MT6765-boot-hardware.patch
	0002-clk-mediatek-mt6765-add-PMIC-wrapper-clock-and-reset.patch
	0003-mmc-mtk-sd-add-MT6765-compatibility.patch
	0004-pinctrl-mediatek-mt6765-map-virtual-PMIC-EINT.patch
	0005-arm64-dts-mediatek-add-MT6765-SoC.patch
	0006-arm64-dts-mediatek-add-Lenovo-Tab-M10-FHD-Plus.patch
	0007-dt-bindings-watchdog-mediatek-add-MT6765-watchdog.patch
	0008-watchdog-mtk-make-MT6765-reboot-through-TOPRGU.patch
	0009-arm64-dts-mediatek-use-the-MT6765-watchdog-compatibl.patch
	$_config
"
builddir="$srcdir/linux-${pkgver/_/-}"

prepare() {
	default_prepare
	mkdir -p "$_outdir"
	cp "$srcdir/$_config" "$_outdir/.config"
	make O="$_outdir" ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image.gz \
		mediatek/mt8768-lenovo-tb-x606f.dtb \
		modules
}

package() {
	local buildroot="$builddir/$_outdir"
	local dtbdir="$buildroot/arch/arm64/boot/dts/mediatek"

	install -Dm644 "$buildroot/arch/arm64/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz-$_flavor"
	install -Dm644 "$dtbdir/mt8768-lenovo-tb-x606f.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt8768-lenovo-tb-x606f.dtb"
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1 \
		modules_install
	rm -f "$pkgdir"/usr/lib/modules/*/build \
		"$pkgdir"/usr/lib/modules/*/source

	install -D "$buildroot/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

