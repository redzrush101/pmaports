# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Yassin Rezai <yassinrsocial@proton.me>
pkgname=device-xiaomi-peridot
pkgdesc="Xiaomi POCO F6 / Redmi Turbo 3"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bootmac
	$pkgname-ucm
	firmware-xiaomi-peridot-adreno
	firmware-xiaomi-peridot-audio
	firmware-xiaomi-peridot-iris
	firmware-xiaomi-peridot-sensors
	hexagonrpcd>=0.5.0_git20260915
	linux-postmarketos-qcom-palawan
	make-dynpart-mappings
	mkbootimg
	msm-firmware-loader>=1.8.0-r5
	postmarketos-base
	soc-qcom
	soc-qcom-qbootctl
"
makedepends="devicepkg-dev"
subpackages="$pkgname-ucm::noarch"
source="
	81-libssc-xiaomi-peridot.rules
	bootmac-bluetooth.conf
	deviceinfo
	hexagonrpcd-sensorspd.conf
	modules-initfs
	ucm/HiFi.conf
	ucm/Xiaomi-Peridot.conf
	xiaomi-peridot-sensors-registry
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/bootmac-bluetooth.conf \
		"$pkgdir"/usr/lib/systemd/system/bootmac@bluetooth.service.d/timeout.conf
	install -Dm644 "$srcdir"/hexagonrpcd-sensorspd.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/10-xiaomi-peridot.conf
	install -Dm755 "$srcdir"/xiaomi-peridot-sensors-registry \
		-t "$pkgdir"/usr/libexec/
	install -Dm644 "$srcdir"/81-libssc-xiaomi-peridot.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/peridot/HiFi.conf
	install -Dm644 "$srcdir"/Xiaomi-Peridot.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/peridot/Xiaomi-Peridot.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/palawan
	ln -s ../../Xiaomi/peridot/Xiaomi-Peridot.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/palawan/Xiaomi-Peridot.conf

	# WCN6750 board data remains on the phone's read-only modem partition.
	# msm-firmware-loader exposes its chipset directory before udev starts.
	mkdir -p "$pkgdir"/usr/lib/firmware/ath11k/WCN6750/hw1.0
	ln -s /run/msm-firmware-loader/target/qca6750/bdwlan.elf \
		"$pkgdir"/usr/lib/firmware/ath11k/WCN6750/hw1.0/board.bin
	ln -s /run/msm-firmware-loader/target/qca6750/regdb.bin \
		"$pkgdir"/usr/lib/firmware/ath11k/WCN6750/hw1.0/regdb.bin
}

ucm() {
	pkgdesc="ALSA UCM configuration for Xiaomi POCO F6 / Redmi Turbo 3"
	license="BSD-3-Clause"
	depends="alsa-ucm-conf"
	amove usr/share/alsa
}

